# Copy to .env and fill in. Values starting EXPO_PUBLIC_ are embedded in the app.

# --- Maps need no key (MapLibre + OpenFreeMap). Optional extras:
# Official Google Street View viewer in the app (Maps Embed API, free). Restrict the key to https://uklifedrop.app/
EXPO_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
# Your own satellite tiles instead of Esri World Imagery
# EXPO_PUBLIC_SATELLITE_TILE_URL=https://api.maptiler.com/tiles/satellite-v2/{z}/{x}/{y}.jpg?key=YOUR_KEY
# EXPO_PUBLIC_SATELLITE_ATTRIBUTION=© MapTiler © Maxar

# --- Extra defibrillator feeds (GeoJSON or CSV) baked into the build: "Name|https://url,Name 2|https://url2"
# EXPO_PUBLIC_EXTRA_FEEDS=
# EXPO_PUBLIC_NATIONAL_DATA_URL=https://openaedmap.org/api/v1/countries/GB.geojson

# --- App identifiers (optional overrides)
# IOS_BUNDLE_ID=uk.lifedrop.aed
# ANDROID_PACKAGE=uk.lifedrop.aed
# EAS_PROJECT_ID=

# --- Identify your app to OpenFreeMap, OpenAEDMap and Overpass (required by their usage policies).
EXPO_PUBLIC_HTTP_USER_AGENT=UKLifeDropAED/1.0 (https://example.org; contact@example.org)
# Comma-separated list, tried in order. Strongly recommended for production: your own or a paid instance.
# EXPO_PUBLIC_OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter

# --- what3words (optional). Without a key the button opens the what3words website at the coordinates.
EXPO_PUBLIC_W3W_API_KEY=

# --- Firebase (optional). Without these, community additions stay on the device only.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
